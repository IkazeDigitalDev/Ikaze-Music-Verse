rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'YOUR_ADMIN_EMAIL@example.com';
    }
    match /lesson-assets/{adminUid}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 100 * 1024 * 1024;
    }
  }
}
